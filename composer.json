{
    "name": "iperson1337/opendxp-data-importer",
    "license": "GPL-3.0-or-later",
    "type": "opendxp-bundle",
    "description": "Adds a comprehensive import functionality to OpenDXP Datahub (fork: + NumericRange/Time/ObjectField operators, MultiAttribute load strategy, FindParentAndCreateFolder location strategy, empty-row-aware xlsx handling)",
    "config": {
        "sort-packages": true,
        "preferred-install": {
            "open-dxp/opendxp": "source",
            "*": "dist"
        },
        "allow-plugins": {
            "symfony/runtime": true
        }
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "doctrine/dbal": "^2.12 || ^3.8",
        "dragonmantank/cron-expression": "^3.1",
        "league/flysystem-sftp-v3": "^3.0",
        "nesbot/carbon": "^3.0",
        "phpoffice/phpspreadsheet": "^2.2 || ^3.3",
        "iperson1337/opendxp-data-hub": "^1.0",
        "open-dxp/opendxp": "^1.1",
        "symfony/mime": "^7.4",
        "webmozarts/console-parallelization": "^2.0"
    },
    "require-dev": {
        "codeception/codeception": "^5.3.5",
        "codeception/module-asserts": "^3.2",
        "codeception/module-symfony": "^3.8",
        "codeception/phpunit-wrapper": "^9",
        "phpunit/phpunit": "^9.3",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-symfony": "^2.0.15",
        "symfony/dotenv": "^7.3",
        "symfony/runtime": "^7.3"
    },
    "autoload": {
        "psr-4": {
            "OpenDxp\\Bundle\\DataImporterBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenDxp\\Bundle\\DataImporterBundle\\Tests\\": "tests"
        },
        "files": [
            "kernel/Kernel.php"
        ]
    },
    "extra": {
        "opendxp": {
            "bundles": [
                "OpenDxp\\Bundle\\DataImporterBundle\\OpenDxpDataImporterBundle"
            ]
        }
    }
}
